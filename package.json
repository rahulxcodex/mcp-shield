{
  "name": "mcpshld",
  "version": "1.0.15",
  "description": "The Zero-Trust Security Gateway, AST Firewall & Secret Sanitizer for Model Context Protocol (MCP) and AI Agents.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-shield": "./bin/mcp-shield.js",
    "mcpshld": "./bin/mcp-shield.js"
  },
  "files": [
    "dist",
    "bin",
    "cloud-dashboard",
    "shield.config.default.yaml",
    "LICENSE",
    "README.md",
    "BENCHMARKS.md",
    "REDTEAM.md",
    "SECURITY.md",
    "THREAT_MODEL.md"
  ],
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.js",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "test:redteam": "node scripts/run-tests.js tests/redteam",
    "test:integration": "node scripts/run-tests.js tests/integration",
    "test:perf-gate": "ts-node scripts/bench-gate.ts",
    "fuzz": "ts-node scripts/fuzz.ts",
    "bench": "ts-node benchmarks/proxy-latency.bench.ts",
    "bench:secrets": "ts-node benchmarks/secret-detection.bench.ts",
    "bench:tokens": "ts-node benchmarks/token-overhead.bench.ts",
    "bench:all": "ts-node benchmarks/proxy-latency.bench.ts",
    "demo:verify": "ts-node scripts/demo-verify.ts",
    "telemetry:demo": "ts-node scripts/send-demo-telemetry.ts",
    "sbom": "cyclonedx-npm --output-format JSON --output-file mcp-shield.sbom.json",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "zero-trust",
    "firewall",
    "dlp",
    "ast-parser",
    "ai-agents",
    "sandbox",
    "container"
  ],
  "author": "MCP-Shield Contributors",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "ink": "^7.1.1",
    "js-yaml": "^5.4.1",
    "mcpshld": "^1.0.5",
    "react": "^19.2.8",
    "tree-sitter": "0.25.1",
    "tree-sitter-bash": "0.25.1",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "fast-check": "^4.9.0",
    "jest": "^30.5.0",
    "playwright": "^1.62.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
