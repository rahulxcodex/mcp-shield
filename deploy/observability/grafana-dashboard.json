  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Total Tool Requests / sec",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(mcp_shield_requests_total[1m]))",
          "legendFormat": "RPS"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "p99 Proxy Latency Overhead",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(mcp_shield_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p99 Latency (ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Blocked Attack Attempts",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(mcp_shield_security_violations_total[1h]))",
          "legendFormat": "Violations (1h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "🚨 Honeypot / Canary Hits",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(increase(mcp_shield_honeypot_triggers_total[1h]))",
          "legendFormat": "Canary Traps"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "dark-red", "mode": "fixed" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Traffic Decision Breakdown (Allow vs Block vs Redact)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (action) (rate(mcp_shield_requests_total[1m]))",
          "legendFormat": "{{ action }}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Latency Distribution (p50, p95, p99)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(mcp_shield_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p50 (ms)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(mcp_shield_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p95 (ms)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(mcp_shield_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p99 (ms)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 7,
      "title": "Semantic Rate Limiting & Token Budget Consumption",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(mcp_shield_tokens_consumed_total[1m]))",
          "legendFormat": "Tenant {{ tenant_id }} Tokens/sec"
        }
      ]
    }
  ],
